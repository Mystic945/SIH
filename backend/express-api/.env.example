# ---- AgriQueue :: Express API ----
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (SAME database is shared with the FastAPI service)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agriqueue?retryWrites=true&w=majority
MONGO_DB_NAME=agriqueue

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS (frontend origin)
CLIENT_ORIGIN=http://localhost:5173

# FastAPI intelligence service (Express proxies /api/v1/intel/* to this)
FASTAPI_URL=http://localhost:8000
INTERNAL_API_KEY=agriqueue-internal-key

# SMS gateway. Leave MOCK for the demo — messages are persisted + streamed to the UI.
SMS_PROVIDER=MOCK
SMS_SENDER_ID=AGRIQ
