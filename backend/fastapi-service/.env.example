# ---- AgriQueue :: FastAPI Intelligence Service ----
# Point this at the SAME MongoDB Atlas cluster + database as the Express API.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agriqueue?retryWrites=true&w=majority
MONGO_DB_NAME=agriqueue

PORT=8000
ENVIRONMENT=development

# Must match INTERNAL_API_KEY in backend/express-api/.env
INTERNAL_API_KEY=agriqueue-internal-key

# Allowed browser origins (the frontend can also call FastAPI directly)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Express API base URL, used for service-to-service callbacks
EXPRESS_URL=http://localhost:5000
